    "controls": [
      "same-core H0",
      "strong592 H1 and H2prefix from prior pilot"
    ],
    "common": "H4 boundary, inner .5e-8 norm(original b), max3 repairs, original relative1e-8.",
    "scope": "Dense free eigensystem construction, static representation gate; no learned acquisition, native timing or full-memory claim. Optimal spectral truncation only in whitened inverse error, not coupled Schur error or CG iterations.",
